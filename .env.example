# Local dev: local Postgres (Docker or Homebrew). Production: RDS endpoint + DATABASE_SSL=true
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest360
DATABASE_SSL=false

# Generate with: openssl rand -hex 32
PAYLOAD_SECRET=

# Optional, local dev only: skip the admin login page by signing in as this existing user
PAYLOAD_AUTOLOGIN_EMAIL=

# Leave S3_BUCKET empty to store uploads on local disk (fine until AWS is set up).
# To use S3: S3_BUCKET=nest360-media-dev plus the keys below
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
