# Leave DATABASE_URL unset to keep local data in a SQLite file (local.db). Set it to use Postgres:
# local Postgres (Docker or Homebrew), or in production the RDS endpoint plus DATABASE_SSL=true
# DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nest360
DATABASE_SSL=false

# Required in production. Generate with: openssl rand -hex 32 (development falls back to a built-in one)
PAYLOAD_SECRET=

# Optional, local dev only: skip the admin login page by signing in as this existing user
PAYLOAD_AUTOLOGIN_EMAIL=

# Leave S3_BUCKET empty to store uploads on local disk (fine until AWS is set up).
# To use S3: S3_BUCKET=nest360-media-dev plus the keys below
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Shared secret to preview drafts. Generate with: openssl rand -hex 32
PREVIEW_SECRET=
