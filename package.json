{
  "name": "nest360-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "measure:bandwidth": "playwright install chromium && node scripts/measure-bandwidth.ts",
    "payload": "payload",
    "generate:types": "payload generate:types",
    "generate:importmap": "payload generate:importmap",
    "seed": "payload run scripts/seed.ts",
    "seed:sample": "payload run scripts/seed-sample.ts",
    "seed:resources": "payload run scripts/seed-resources.ts",
    "seed:publications": "payload run scripts/seed-publications.ts",
    "seed:technologies": "payload run scripts/seed-technologies.ts",
    "staff:setup-admin": "payload run scripts/setup-admin.ts",
    "test:staff-access": "payload run tests/staff-access.integration.ts",
    "migration:prepare": "python3 scripts/migration/prepare.py",
    "migration:import": "payload run scripts/migration/run.ts",
    "test:migration": "python3 -m unittest discover -s tests/migration -p \"test_*.py\" && payload run tests/migration/import.integration.ts"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.10",
    "@payloadcms/db-postgres": "^3.92.0",
    "@payloadcms/db-sqlite": "^3.92.0",
    "@payloadcms/live-preview-react": "^3.92.0",
    "@payloadcms/next": "^3.92.0",
    "@payloadcms/plugin-search": "^3.92.0",
    "@payloadcms/richtext-lexical": "^3.92.0",
    "@payloadcms/storage-s3": "^3.92.0",
    "fflate": "^0.8.3",
    "graphql": "^16.14.2",
    "next": "^16.3.8",
    "payload": "^3.92.0",
    "pdfjs-dist": "^6.4.299",
    "react": "19.2.8",
    "react-colorful": "^5.8.1",
    "react-dom": "19.2.8",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "playwright": "^1.65.1",
    "tailwindcss": "^4",
    "typescript": "^5"
  },
  "type": "module",
  "engines": {
    "node": "^22.23.4 || >=24.22.1"
  }
}
